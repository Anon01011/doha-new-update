APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=base64:h/qPVsk0Yru+B5sq3b8EJFQFHCJQF39CQYLEXot8VRc=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# IMPORTANT: the test suite must never touch a real MySQL database.
# `migrate:fresh --env=testing` would otherwise fall back to .env and
# DROP every table in the development/production schema.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=4